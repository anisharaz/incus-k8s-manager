KVM_GID=990
SETIPTABLES=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=incus_k8s_manager
# JWT_SECRET=

# The bundled `proxy` service terminates TLS in front of the app, so this
# should stay "true". Set to "false" only if you remove that service and
# access `app` over plain HTTP directly (e.g. local testing).
COOKIE_SECURE=true
