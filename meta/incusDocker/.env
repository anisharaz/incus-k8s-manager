# Docker Compose environment for the KII (Incus) container.
# `docker compose` auto-loads this file from the same directory,
# feeding the ${VAR:-default} placeholders in docker-compose.yml.

# Host's kvm group GID — used to remap the container kvm group so VMs
# get the right /dev/kvm permissions.
# Find yours on THIS host with one of:
#   getent group kvm          # kvm:x:990:anish  -> GID is 990
#   grep '^kvm:' /etc/group   # kvm:x:990:
#   stat -c '%g' /dev/kvm     # 990
KVM_GID=990

# Set to "false" to skip adding ACCEPT rules to the DOCKER-USER
# iptables chains (for hosts that don't need the docker iptables fix).
SETIPTABLES=true
