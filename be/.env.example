# Server Configuration
PORT=8000
ENV=development

# Database Configuration
# Used by the application (via DATABASE_URL) and the migrate CLI.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/incus_k8s_manager?sslmode=disable

# Individual DB settings (fallback if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=incus_k8s_manager
# DB_USER=postgres
# DB_PASSWORD=postgres

# Path to the Incus unix socket (shared by the incus container, see
# meta/incusDocker/docker-compose.yml's incus-socket-share volume)
INCUS_SOCKET_PATH=/shared-socket/incus.sock

# Signing key for session tokens. If unset, a random one is generated at
# startup (logged as a warning) and every restart invalidates all
# sessions. Set this to a long random string in any real deployment.
# JWT_SECRET=

# Set to "true" only if there's TLS terminating in front of this app right
# now (the bundled Caddy proxy in docker-compose, or a future Kubernetes
# Ingress) — it marks the session cookie Secure, which browsers then refuse
# to store/send over a plain HTTP connection. Leave false for local dev.
COOKIE_SECURE=false
