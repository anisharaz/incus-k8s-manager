# Server Configuration
PORT=8000
ENV=development

# Database Configuration
# Used by the application (via DATABASE_URL) and the migrate CLI.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/incus_k8s_manager?sslmode=disable

# Individual DB settings (fallback if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=incus_k8s_manager
# DB_USER=postgres
# DB_PASSWORD=postgres

# Path to the Incus unix socket (shared by the incus container, see
# meta/incusDocker/docker-compose.yml's incus-socket-share volume)
INCUS_SOCKET_PATH=/shared-socket/incus.sock
